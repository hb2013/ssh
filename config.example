# clip-sync 配置文件模板
# 复制为 config 后填写，或直接运行 ./setup.sh 自动生成（推荐，会自动探测密钥）
#
# 多台: 一张图会同步到所有目标，每台独立重试
REMOTE_HOSTS=("user@192.168.1.100" "user@100.86.234.0")
# REMOTE_KEYS 与 REMOTE_HOSTS 一一对应:
#   ""            = 该台用默认密钥
#   "/Users/你/.ssh/id_rsa_server" = 该台用指定密钥（非默认名密钥时由 setup.sh 自动探测写入）
REMOTE_KEYS=("" "/Users/你/.ssh/id_rsa_server")
#
# 旧的单地址写法仍然兼容: REMOTE_HOST="user@192.168.1.100"
